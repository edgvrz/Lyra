@page
@model RegisterModel
@{ ViewData["Title"] = "Crear cuenta"; Layout = "_Layout"; }

<div class="auth-page">
    <!-- Lado izquierdo -->
    <div class="auth-left">
        <div class="auth-left-logo">
            <img src="~/img/precisa-logo.png" alt="PRECISA"
                 onerror="this.style.display='none'" />
        </div>
        <h1 class="auth-left-title">PRECISA</h1>
        <p class="auth-left-sub">Precisamente Bella</p>
        <p class="auth-left-quote">
            "Descubre tu tipo de cuerpo, conoce tus colores y
            encuentra las prendas que te hacen brillar."
        </p>
        <div style="margin-top:2rem;text-align:left;width:100%;max-width:280px">
            <p style="font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;
                      color:rgba(255,255,255,.5);margin-bottom:.75rem">¿Tipo de cuenta?</p>
            <div style="display:flex;flex-direction:column;gap:.5rem">
                <div style="background:rgba(255,255,255,.1);border-radius:10px;
                            padding:.65rem 1rem;font-size:.82rem;color:rgba(255,255,255,.85)">
                    👗 <strong>Clienta</strong> — cualquier correo
                </div>
                <div style="background:rgba(255,255,255,.1);border-radius:10px;
                            padding:.65rem 1rem;font-size:.82rem;color:rgba(255,255,255,.85)">
                    🏪 <strong>Tienda</strong> — correo <em>@("tienda.com")</em>
                </div>
                <div style="background:rgba(255,255,255,.1);border-radius:10px;
                            padding:.65rem 1rem;font-size:.82rem;color:rgba(255,255,255,.85)">
                    ⚙ <strong>Admin</strong> — correo <em>@("admin.com")</em>
                </div>
            </div>
        </div>
    </div>

    <!-- Lado derecho -->
    <div class="auth-right">
        <div class="auth-form-box">
            <h2 class="auth-form-title">Crear mi cuenta</h2>
            <p class="auth-form-sub">Únete a PRECISA y descubre tu estilo</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-3 py-2 px-3"
                     style="font-size:.85rem">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="lyra-label">Correo electrónico</label>
                    <input asp-for="Input.Email" class="auth-input"
                           autocomplete="username" placeholder="tu@correo.com" />
                    <span asp-validation-for="Input.Email"
                          style="font-size:.78rem;color:#c0392b;margin-top:.3rem;display:block"></span>
                </div>

                <div class="mb-3">
                    <label class="lyra-label">Contraseña</label>
                    <input asp-for="Input.Password" class="auth-input"
                           type="password" autocomplete="new-password"
                           placeholder="Mínimo 6 caracteres" />
                    <span asp-validation-for="Input.Password"
                          style="font-size:.78rem;color:#c0392b;margin-top:.3rem;display:block"></span>
                </div>

                <div class="mb-4">
                    <label class="lyra-label">Confirmar contraseña</label>
                    <input asp-for="Input.ConfirmPassword" class="auth-input"
                           type="password" autocomplete="new-password"
                           placeholder="Repite tu contraseña" />
                    <span asp-validation-for="Input.ConfirmPassword"
                          style="font-size:.78rem;color:#c0392b;margin-top:.3rem;display:block"></span>
                </div>

                <button type="submit" class="auth-btn">Crear mi cuenta →</button>

                <div class="auth-divider"><span>¿Ya tienes cuenta?</span></div>

                <div style="text-align:center">
                    <a asp-page="./Login" class="auth-link">Iniciar sesión</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }