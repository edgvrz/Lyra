@model Lyra.Models.UsuarioPerfil
@using Lyra.Services
@using Lyra.Enums
@{
    ViewData["Title"] = "Mi Dashboard";
    var tipoCuerpo = Model.TipoCuerpo ?? "Rectángulo";
    var paleta     = ViewBag.Paleta as ColorimetriaService.PaletaRecomendada;

    // Imagen del maniquí: tipo_cuerpo-tono_piel.png
var imagenTipo = tipoCuerpo switch
{
    "Reloj de Arena"      => "reloj-de-arena",
    "Triángulo"           => "triangulo",
    "Triángulo Invertido" => "triangulo-invertido",
    "Rectángulo"          => "rectangulo",
    _                     => "ovalado"
};

var imagenTono = Model.TonoPiel switch
{
    TonoPielEnum.Claro      => "claro",
    TonoPielEnum.MedioClaro => "medio-claro",
    TonoPielEnum.Medio      => "medio",
    TonoPielEnum.Oliva      => "oliva",
    TonoPielEnum.Moreno     => "moreno",
    TonoPielEnum.Oscuro     => "oscuro",
    _                       => "claro"
};

// Nombre final de imagen: ej. "reloj-de-arena-claro.png"
var imagenManiqui = $"{imagenTipo}-{imagenTono}.png";

    var tipoDesc = tipoCuerpo switch
    {
        "Reloj de Arena"      => "Tu cintura es visiblemente más estrecha que hombros y cadera, que son similares. Una de las siluetas más versátiles en moda.",
        "Triángulo"           => "Tu cadera es notablemente más ancha que tus hombros. Añadir volumen en la parte superior equilibra y estiliza tu figura.",
        "Triángulo Invertido" => "Tus hombros son más anchos que tu cadera. Los estilos que añaden volumen inferior crean un balance visual elegante.",
        "Rectángulo"          => "Tus hombros, cintura y cadera tienen proporciones similares. Marcar la cintura o añadir texturas te favorece mucho.",
        _                     => "Tu zona media es más prominente. Las líneas verticales y cortes en A estilizan tu figura naturalmente.",
    };

    var tipoTips = tipoCuerpo switch
    {
        "Reloj de Arena"      => new[] { "Vestidos ceñidos", "Falda lápiz", "Top ajustado", "Cinturones marcados" },
        "Triángulo"           => new[] { "Blusa con volumen", "Blazer estructurado", "Off-shoulder", "Estampados arriba" },
        "Triángulo Invertido" => new[] { "Pantalón acampanado", "Falda con vuelo", "Vestido evasé", "Faldas amplias" },
        "Rectángulo"          => new[] { "Vestido con cinturón", "Blusa con pliegues", "Capas y texturas", "Volumen en busto" },
        _                     => new[] { "Vestido línea A", "Conjunto fluido", "Chaqueta larga", "Escotes en V" },
    };
}

<style>
.hero-card { background:#fff; border:1px solid #ede9e3; border-radius:18px; padding:2rem; margin-bottom:1.25rem; }
.tip-chip  { display:inline-block; background:#f5f1eb; color:#5a4e3e; border-radius:20px;
             padding:.3rem .85rem; font-size:.8rem; margin:.25rem .18rem; }
.color-chip { width:36px; height:36px; border-radius:50%; border:2px solid rgba(0,0,0,.08); flex-shrink:0; }
.chip-x { opacity:.5; position:relative; }
.chip-x::after { content:'✕'; position:absolute; inset:0; display:flex; align-items:center;
  justify-content:center; font-size:.65rem; color:#fff; text-shadow:0 0 3px rgba(0,0,0,.9); }
</style>

<div class="lyra-wrap">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="lyra-title" style="font-size:1.9rem">Hola, @Model.Nombre 👋</h1>
            <p style="color:#888;margin:.3rem 0 0;font-size:.9rem">Tu perfil de estilo está listo</p>
        </div>
        <a asp-action="CompletarPerfil" class="btn-lyra-ghost">✏ Editar perfil</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-3 py-2 px-3" style="font-size:.9rem">
            ✓ @TempData["Success"]
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-num">@(ViewBag.TotalFavoritos ?? 0)</div>
                <div class="stat-label">Guardadas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div style="font-family:'Playfair Display',serif;font-size:.95rem;color:#1a1a1a;padding-top:.5rem;line-height:1.3">
                    @tipoCuerpo
                </div>
                <div class="stat-label">Tipo de cuerpo</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-num">@Model.Estatura</div>
                <div class="stat-label">Estatura (cm)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-num">@Model.Peso</div>
                <div class="stat-label">Peso (kg)</div>
            </div>
        </div>
    </div>

    <!-- HERO: Maniquí + Info -->
    <div class="hero-card">
        <div class="row g-4 align-items-center">

            <!-- Maniquí -->
<div class="col-md-4 text-center">
    <img src="~/img/cuerpos/@imagenManiqui"
         alt="Tipo de cuerpo @tipoCuerpo"
         style="height:300px;width:auto;display:block;margin:0 auto;
                object-fit:contain;border-radius:12px"
         onerror="this.src='/img/cuerpos/rectangulo-claro.png'" />
</div>

            <!-- Info -->
            <div class="col-md-8">
                <p class="lyra-label mb-1">Tu tipo de cuerpo detectado</p>
                <h2 style="font-family:'Playfair Display',serif;font-size:2rem;color:#1a1a1a;margin:0 0 .6rem">
                    @tipoCuerpo
                </h2>
                <div style="display:inline-block;background:#1a1a1a;color:#fff;border-radius:8px;
                            padding:.3rem 1rem;font-size:.8rem;font-weight:500;margin-bottom:.9rem">
                    @Model.TonoPiel &nbsp;·&nbsp; Subtono @(paleta?.Subtono ?? "—")
                </div>
                <p style="font-size:.9rem;color:#666;line-height:1.75;margin-bottom:1.25rem;max-width:440px">
                    @tipoDesc
                </p>
                <p class="lyra-label mb-2">✓ Prendas que te favorecen</p>
                <div style="margin-bottom:1.75rem">
                    @foreach (var tip in tipoTips)
                    { <span class="tip-chip">@tip</span> }
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:.75rem">
                    <a asp-action="Recomendaciones" class="btn-lyra" style="padding:.85rem 1.75rem">
                        ✨ Ver prendas para mí
                    </a>
                    <a asp-action="Favoritos" class="btn-lyra-ghost" style="padding:.85rem 1.5rem">
                        ♥ Guardadas
                        @if ((int)(ViewBag.TotalFavoritos ?? 0) > 0)
                        { <span class="pill pill-dark ms-1">@ViewBag.TotalFavoritos</span> }
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Colorimetría -->
    @if (paleta != null)
    {
        <div class="lyra-card" style="margin-bottom:1.25rem">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;
                        margin-bottom:1rem;flex-wrap:wrap;gap:.5rem">
                <div>
                    <p class="lyra-label mb-0">Tu paleta de colores</p>
                    <p style="font-family:'Playfair Display',serif;font-size:1.05rem;color:#1a1a1a;margin:.2rem 0 0">
                        Subtono @paleta.Subtono
                    </p>
                </div>
                <a asp-action="Recomendaciones" class="btn-lyra btn-lyra-sm">
                    Ver prendas con estos colores →
                </a>
            </div>
            <p style="font-size:.85rem;color:#666;line-height:1.65;margin-bottom:1.25rem;
                      background:#faf8f5;padding:.85rem 1rem;border-radius:10px;
                      border-left:3px solid #c9b99a">
                @paleta.Tip
            </p>
            <p class="lyra-label mb-2">✓ Colores que te favorecen</p>
            <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem">
                @foreach (var c in paleta.Favorecen)
                {
                    <div style="display:flex;flex-direction:column;align-items:center;gap:.35rem">
                        <div class="color-chip" style="background:@c.Hex" title="@c.Nombre"></div>
                        <span style="font-size:.65rem;color:#888;text-align:center;max-width:52px;line-height:1.2">
                            @c.Nombre
                        </span>
                    </div>
                }
            </div>
            <p class="lyra-label mb-2">✕ Colores a evitar</p>
            <div style="display:flex;flex-wrap:wrap;gap:1rem">
                @foreach (var c in paleta.Evitar)
                {
                    <div style="display:flex;flex-direction:column;align-items:center;gap:.35rem">
                        <div class="color-chip chip-x" style="background:@c.Hex" title="@c.Nombre"></div>
                        <span style="font-size:.65rem;color:#bbb;text-align:center;max-width:52px;line-height:1.2">
                            @c.Nombre
                        </span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Medidas + Acciones -->
    <div class="row g-3">
        <div class="col-md-5">
            <div class="lyra-card h-100">
                <p class="lyra-label mb-3">Tu perfil corporal</p>
                @if (Model.MedidasCorporales != null)
                {
                    var m = Model.MedidasCorporales;
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem">
                        @foreach (var (nm, val) in new[] {
                            ("Hombros", m.Hombros), ("Busto",  m.Busto),
                            ("Cintura", m.Cintura), ("Cadera", m.Cadera)
                        })
                        {
                            <div style="background:#faf8f5;border-radius:12px;padding:.9rem 1rem">
                                <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.05em;color:#aaa">
                                    @nm
                                </div>
                                <div style="font-family:'Playfair Display',serif;font-size:1.3rem;
                                            color:#1a1a1a;margin-top:.15rem">
                                    @val <span style="font-size:.7rem;color:#aaa">cm</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div style="margin-top:1rem">
                    <span class="pill pill-dark">@tipoCuerpo</span>
                    <span class="pill pill-cream ms-1">@Model.TonoPiel</span>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="lyra-card">
                <p class="lyra-label mb-3">Acciones rápidas</p>
                <div style="display:flex;flex-direction:column;gap:.75rem">
                    <a asp-action="Recomendaciones" class="btn-lyra"
                       style="justify-content:center;padding:1rem">
                        ✨ Ver mis recomendaciones
                    </a>
                    <a asp-action="Favoritos" class="btn-lyra-ghost"
                       style="justify-content:center;padding:1rem">
                        ♥ Mis prendas guardadas
                    </a>
                    <a asp-action="CompletarPerfil" class="btn-lyra-ghost"
                       style="justify-content:center;padding:1rem">
                        📏 Actualizar medidas
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
