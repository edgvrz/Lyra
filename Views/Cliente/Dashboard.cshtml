@model Lyra.Models.UsuarioPerfil
@using Lyra.Services
@using Lyra.Enums
@{
    ViewData["Title"] = "Mi Dashboard";
    var tipoCuerpo = Model.TipoCuerpo ?? "Rectángulo";
    var paleta     = ViewBag.Paleta as ColorimetriaService.PaletaRecomendada;

    var skinTones = new Dictionary<TonoPielEnum, (string Fill, string Stroke)>
    {
        [TonoPielEnum.Claro]      = ("#f5e6d5", "#d4b896"),
        [TonoPielEnum.MedioClaro] = ("#e8c49a", "#c4956a"),
        [TonoPielEnum.Medio]      = ("#c8844a", "#a0602a"),
        [TonoPielEnum.Oliva]      = ("#a0693a", "#7a4e1e"),
        [TonoPielEnum.Moreno]     = ("#7a4828", "#5a3010"),
        [TonoPielEnum.Oscuro]     = ("#3d1f10", "#200d02"),
    };
    var (skinFill, skinStroke) = skinTones.ContainsKey(Model.TonoPiel)
        ? skinTones[Model.TonoPiel] : ("#e8c9a0", "#c4956a");

    var palette = paleta?.Favorecen.Select(c => c.Hex).ToList()
                  ?? new List<string> { "#c4a882", "#5a6d8a", "#7a6050" };
    while (palette.Count < 6) palette.Add("#c4a882");

    var outfits = new Dictionary<string, List<(string Nombre, string Tip, string SvgId)>>
    {
        ["Triángulo"] = new() {
            ("Blusa con volumen",     "Mangas abullonadas equilibran hombros y cadera",  "blusa"),
            ("Blazer estructurado",   "Crea hombros más anchos y define la figura",       "blazer"),
            ("Vestido escote amplio", "Dirige la atención hacia arriba naturalmente",     "escote"),
        },
        ["Reloj de Arena"] = new() {
            ("Vestido de envoltura",  "Abraza y define tu cintura perfectamente",         "wrap"),
            ("Falda lápiz + top",     "Línea limpia que acentúa tus curvas",             "lapiz"),
            ("Jeans de tiro alto",    "Resalta la cintura y alarga las piernas",         "jeans"),
        },
        ["Triángulo Invertido"] = new() {
            ("Pantalón acampanado",   "Wide leg equilibra hombros y cadera",             "wideleg"),
            ("Falda con vuelo",       "Añade volumen donde más lo necesitas",            "vuelo"),
            ("Vestido evasé",         "Silueta A que equilibra la figura",               "evase"),
        },
        ["Rectángulo"] = new() {
            ("Vestido con cinturón",  "El cinturón crea la cintura visualmente",         "cinturon"),
            ("Blusa con pliegues",    "Añade dimensión y movimiento al torso",           "pliegues"),
            ("Conjunto en capas",     "Las capas crean profundidad y curvas visuales",   "capas"),
        },
        ["Ovalado"] = new() {
            ("Vestido línea A",       "La silueta A fluye desde el busto hacia abajo",  "aline"),
            ("Conjunto fluido",       "Telas que caen naturalmente, sin ceñir",         "fluido"),
            ("Chaqueta larga",        "Las capas largas estilizan verticalmente",       "chaqueta"),
        },
    };
    var misOutfits = outfits.ContainsKey(tipoCuerpo) ? outfits[tipoCuerpo] : outfits["Rectángulo"];
}

<style>
.car-slide        { display:none; }
.car-slide.active { display:block; animation:fadeIn .3s ease; }
@@keyframes fadeIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:none} }
.car-card  { background:#faf8f5; border:1px solid #ede9e3; border-radius:14px;
             padding:1.5rem; text-align:center; }
.car-name  { font-family:'Playfair Display',serif; font-size:1.05rem; color:#1a1a1a;
             margin:.75rem 0 .3rem; }
.car-tip   { font-size:.8rem; color:#888; line-height:1.5; max-width:340px; margin:0 auto; }
.car-nav   { display:flex; justify-content:space-between; align-items:center; margin-top:1rem; }
.car-btn   { background:transparent; border:1px solid #ddd; border-radius:8px;
             padding:.4rem 1.1rem; cursor:pointer; font-size:.85rem; color:#555;
             font-family:'DM Sans',sans-serif; transition:border-color .2s; }
.car-btn:hover    { border-color:#999; color:#1a1a1a; }
.car-btn:disabled { opacity:.35; cursor:default; }
.car-dots  { display:flex; gap:.5rem; }
.car-dot   { width:8px; height:8px; border-radius:50%; background:#ddd;
             transition:all .2s; cursor:pointer; }
.car-dot.on { background:#1a1a1a; transform:scale(1.25); }
.color-chip { width:38px; height:38px; border-radius:50%;
              border:2px solid rgba(0,0,0,.08); flex-shrink:0; }
.chip-x { opacity:.5; position:relative; }
.chip-x::after { content:'✕'; position:absolute; inset:0; display:flex;
  align-items:center; justify-content:center; font-size:.65rem; color:#fff;
  text-shadow:0 0 3px rgba(0,0,0,.9); }
</style>

<div class="lyra-wrap">

    <div class="page-header">
        <div>
            <h1 class="lyra-title" style="font-size:1.9rem">Hola, @Model.Nombre 👋</h1>
            <p style="color:#888;margin:.3rem 0 0;font-size:.9rem">Tu perfil de estilo está listo</p>
        </div>
        <a asp-action="CompletarPerfil" class="btn-lyra-ghost">✏ Editar perfil</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-3 mb-3 py-2 px-3" style="font-size:.9rem">
            ✓ @TempData["Success"]
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-num">@(ViewBag.TotalFavoritos ?? 0)</div>
                <div class="stat-label">Guardadas</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div style="font-family:'Playfair Display',serif;font-size:1rem;color:#1a1a1a;
                            padding-top:.5rem;line-height:1.2">@tipoCuerpo</div>
                <div class="stat-label">Tipo de cuerpo</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-num">@Model.Estatura</div>
                <div class="stat-label">Estatura (cm)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div class="stat-num">@Model.Peso</div>
                <div class="stat-label">Peso (kg)</div>
            </div>
        </div>
    </div>

    <!-- ── Carrusel ── -->
    <div class="lyra-card" style="margin-bottom:1.25rem">
        <div style="display:flex;justify-content:space-between;align-items:flex-start;
                    margin-bottom:1.25rem;flex-wrap:wrap;gap:.5rem">
            <div>
                <p class="lyra-label mb-0">Outfits recomendados para ti</p>
                <p style="font-family:'Playfair Display',serif;font-size:1.05rem;
                           color:#1a1a1a;margin:.2rem 0 0">
                    @tipoCuerpo — con tus colores favorables
                </p>
            </div>
            <span class="pill pill-dark">@tipoCuerpo</span>
        </div>

        @for (int i = 0; i < misOutfits.Count; i++)
        {
            var (nombre, tip, svgId) = misOutfits[i];
            var c1 = palette[i % palette.Count];
            var c2 = palette[(i + 3) % palette.Count];
            <div class="car-slide @(i == 0 ? "active" : "")">
                <div class="car-card">
                    <div style="max-width:200px;margin:0 auto">
                        @Html.Raw(GetOutfitSvg(svgId, skinFill, skinStroke, c1, c2))
                    </div>
                    <div style="margin-top:.5rem">
                        <span style="font-size:.72rem;color:#888">Color recomendado:</span>
                        <span class="pill ms-1"
                              style="background:@c1;color:@(IsDark(c1)?"#fff":"#1a1a1a");
                                     font-size:.72rem;vertical-align:middle">
                            @(paleta?.Favorecen.ElementAtOrDefault(i % (paleta?.Favorecen.Count ?? 1))?.Nombre ?? "Tu paleta")
                        </span>
                    </div>
                    <p class="car-name">@nombre</p>
                    <p class="car-tip">@tip</p>
                </div>
            </div>
        }

        <div class="car-nav">
            <button class="car-btn" id="carPrev">← Anterior</button>
            <div class="car-dots">
                @for (int i = 0; i < misOutfits.Count; i++)
                {
                    <div class="car-dot @(i == 0 ? "on" : "")" data-target="@i"></div>
                }
            </div>
            <button class="car-btn" id="carNext">Siguiente →</button>
        </div>
    </div>

    <!-- ── Colorimetría ── -->
    @if (paleta != null)
    {
        <div class="lyra-card" style="margin-bottom:1.25rem">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;
                        margin-bottom:1rem;flex-wrap:wrap;gap:.5rem">
                <div>
                    <p class="lyra-label mb-0">Tu paleta de colores</p>
                    <p style="font-family:'Playfair Display',serif;font-size:1.05rem;
                               color:#1a1a1a;margin:.2rem 0 0">Subtono @paleta.Subtono</p>
                </div>
                <a asp-action="Recomendaciones" class="btn-lyra btn-lyra-sm">
                    Ver prendas con estos colores →
                </a>
            </div>
            <p style="font-size:.85rem;color:#666;margin-bottom:1.25rem;line-height:1.65;
                      background:#faf8f5;padding:.85rem 1rem;border-radius:10px;
                      border-left:3px solid #c9b99a">
                @paleta.Tip
            </p>
            <p class="lyra-label mb-2">✓ Colores que te favorecen</p>
            <div style="display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1.5rem">
                @foreach (var c in paleta.Favorecen)
                {
                    <div style="display:flex;flex-direction:column;align-items:center;gap:.35rem">
                        <div class="color-chip" style="background:@c.Hex" title="@c.Nombre"></div>
                        <span style="font-size:.65rem;color:#888;text-align:center;
                                     max-width:52px;line-height:1.2">@c.Nombre</span>
                    </div>
                }
            </div>
            <p class="lyra-label mb-2">✕ Colores a evitar</p>
            <div style="display:flex;flex-wrap:wrap;gap:1rem">
                @foreach (var c in paleta.Evitar)
                {
                    <div style="display:flex;flex-direction:column;align-items:center;gap:.35rem">
                        <div class="color-chip chip-x" style="background:@c.Hex" title="@c.Nombre"></div>
                        <span style="font-size:.65rem;color:#bbb;text-align:center;
                                     max-width:52px;line-height:1.2">@c.Nombre</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- ── Perfil + Acciones ── -->
    <div class="row g-3">
        <div class="col-md-5">
            <div class="lyra-card h-100">
                <p class="lyra-label mb-3">Tu perfil corporal</p>
                @if (Model.MedidasCorporales != null)
                {
                    var m = Model.MedidasCorporales;
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:.8rem">
                        @foreach (var (nm, val) in new[] {
                            ("Hombros", m.Hombros), ("Busto",  m.Busto),
                            ("Cintura", m.Cintura), ("Cadera", m.Cadera)
                        })
                        {
                            <div style="background:#faf8f5;border-radius:12px;padding:.9rem 1rem">
                                <div style="font-size:.72rem;text-transform:uppercase;
                                            letter-spacing:.05em;color:#aaa">@nm</div>
                                <div style="font-family:'Playfair Display',serif;
                                            font-size:1.3rem;color:#1a1a1a;margin-top:.15rem">
                                    @val <span style="font-size:.7rem;color:#aaa">cm</span>
                                </div>
                            </div>
                        }
                    </div>
                }
                <div style="margin-top:1rem">
                    <span class="pill pill-dark">@tipoCuerpo</span>
                    <span class="pill pill-cream ms-1">@Model.TonoPiel</span>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="lyra-card">
                <p class="lyra-label mb-3">Acciones rápidas</p>
                <div style="display:flex;flex-direction:column;gap:.75rem">
                    <a asp-action="Recomendaciones" class="btn-lyra"
                       style="justify-content:center;padding:1rem">
                        ✨ Ver mis recomendaciones
                    </a>
                    <a asp-action="Favoritos" class="btn-lyra-ghost"
                       style="justify-content:center;padding:1rem">
                        ♥ Mis prendas guardadas
                        @if ((int)(ViewBag.TotalFavoritos ?? 0) > 0)
                        { <span class="pill pill-dark ms-1">@ViewBag.TotalFavoritos</span> }
                    </a>
                    <a asp-action="CompletarPerfil" class="btn-lyra-ghost"
                       style="justify-content:center;padding:1rem">
                        📏 Actualizar medidas
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    bool IsDark(string hex) {
        try {
            hex = hex.TrimStart('#');
            int r = Convert.ToInt32(hex[..2], 16);
            int g = Convert.ToInt32(hex[2..4], 16);
            int b = Convert.ToInt32(hex[4..6], 16);
            return (r * 299 + g * 587 + b * 114) / 1000 < 128;
        } catch { return true; }
    }

