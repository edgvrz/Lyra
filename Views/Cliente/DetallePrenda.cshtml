@model Lyra.Models.Prenda
@using Lyra.Enums
@{ ViewData["Title"] = Model.Nombre; }

<div class="lyra-wrap-sm">
    <a asp-action="Recomendaciones" class="btn-lyra-ghost btn-lyra-sm mb-3"
       style="display:inline-flex">← Volver</a>

    <div class="lyra-card" style="padding:0;overflow:hidden">

        @if (!string.IsNullOrEmpty(Model.ImagenUrl))
        {
            <img src="@Model.ImagenUrl"
                 style="width:100%;max-height:420px;object-fit:cover"
                 alt="@Model.Nombre" />
        }
        else
        {
            <div style="width:100%;height:280px;background:#f5f1eb;
                        display:flex;align-items:center;justify-content:center;
                        font-size:4rem">👗</div>
        }

        <div style="padding:1.75rem">
            <p class="pcard-cat">@Model.Categoria</p>
            <h1 class="lyra-title" style="font-size:1.6rem;margin-bottom:.5rem">
                @Model.Nombre
            </h1>

            @if (!string.IsNullOrEmpty(Model.Descripcion))
            {
                <p style="color:#666;font-size:.93rem;line-height:1.7;margin-bottom:1rem">
                    @Model.Descripcion
                </p>
            }

            <!-- Precio y talla -->
            <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem">
                <span style="font-family:'Playfair Display',serif;font-size:1.8rem;color:#1a1a1a">
                    S/ @Model.Precio.ToString("0.00")
                </span>
                <span class="pill pill-cream">@Model.Talla</span>
                <span class="pill" style="background:#f0f0f0;color:#555">@Model.Color</span>
            </div>

            <!-- Compatibilidad -->
            <div style="background:#faf8f5;border-radius:12px;padding:1rem;margin-bottom:1.25rem">
                <p class="lyra-label mb-2">Compatible con</p>
                <div style="display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:.6rem">
                    @foreach (var tipo in Model.TiposCuerpoCompatibles.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)))
                    {
                        <span class="pill pill-dark">@tipo</span>
                    }
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:.4rem">
                    @foreach (var tono in Model.TonosPielCompatibles.Split(',').Select(t => t.Trim()).Where(t => !string.IsNullOrEmpty(t)))
                    {
                        <span class="pill pill-cream">@tono</span>
                    }
                </div>
            </div>

            <!-- Tienda -->
            @if (Model.Tienda != null)
            {
                <div style="border-top:1px solid #ede9e3;padding-top:1rem;margin-bottom:1.25rem">
                    <p class="lyra-label mb-1">Tienda</p>
                    <p style="font-weight:500;color:#1a1a1a;margin:0">@Model.Tienda.Nombre</p>
                    @if (!string.IsNullOrEmpty(Model.Tienda.Ciudad))
                    {
                        <p style="font-size:.82rem;color:#aaa;margin:.2rem 0 0">
                            📍 @Model.Tienda.Ciudad
                        </p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Tienda.Telefono))
                    {
                        <p style="font-size:.82rem;color:#888;margin:.2rem 0 0">
                            📞 @Model.Tienda.Telefono
                        </p>
                    }
                </div>
            }

            <!-- Botón favorito -->
            @if ((bool)ViewBag.EsFavorito)
            {
                <form asp-action="QuitarFavorito" method="post">
                    @Html.AntiForgeryToken()
                    @* necesitamos el favoritoId — ver nota abajo *@
                    <button class="btn-lyra-ghost w-100" style="border-color:#e84393;color:#e84393">
                        ♥ Quitar de guardadas
                    </button>
                </form>
            }
            else
            {
                <form asp-action="AgregarFavorito" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="prendaId" value="@Model.Id" />
                    <button class="btn-lyra w-100">♡ Guardar prenda</button>
                </form>
            }
        </div>
    </div>
</div>