@{ ViewData["Title"] = "Checkout"; }

<style>
.pay-method {
    border: 2px solid var(--cbr);
    border-radius: 14px; padding: 1rem 1.25rem;
    cursor: pointer; transition: all .2s;
    display: flex; align-items: center; gap: 1rem;
    background: var(--csf); margin-bottom: .6rem;
}
.pay-method:hover { border-color: var(--cp); background: var(--csf2); }
.pay-method.selected { border-color: var(--cp); background: var(--grads); }
.pay-radio { display: none; }
.pay-icon  { font-size: 1.75rem; flex-shrink: 0; }
.pay-label { font-weight: 600; color: var(--ctx); font-size: .92rem; }
.pay-sub   { font-size: .77rem; color: var(--ctx2); }

.card-sim {
    background: var(--grad);
    border-radius: 18px; padding: 1.5rem;
    color: #fff; margin-top: 1rem;
    box-shadow: 0 8px 24px var(--csh2);
    position: relative; overflow: hidden;
}
.card-sim::before {
    content: '';
    position: absolute; top: -30px; right: -30px;
    width: 120px; height: 120px;
    border-radius: 50%;
    background: rgba(255,255,255,.1);
}
.card-sim::after {
    content: '';
    position: absolute; bottom: -20px; left: -20px;
    width: 80px; height: 80px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
}
</style>

<div class="lyra-wrap-sm">
    <div class="page-header">
        <div>
            <h1 class="lyra-title" style="font-size:1.9rem">Checkout</h1>
            <p style="color:var(--ctx2);margin:.3rem 0 0;font-size:.9rem">
                Elige cómo pagar y confirma tu pedido
            </p>
        </div>
        <a asp-action="Index" class="btn-lyra-ghost btn-lyra-sm">← Carrito</a>
    </div>

    <!-- Resumen rápido -->
    <div class="lyra-card" style="margin-bottom:1.25rem">
        <p class="lyra-label mb-2">Resumen</p>
        @foreach (var item in (List<Lyra.Models.CarritoItem>)ViewBag.Items)
        {
            <div style="display:flex;justify-content:space-between;align-items:center;
                        padding:.5rem 0;border-bottom:1px solid var(--cbr)">
                <div style="display:flex;align-items:center;gap:.75rem">
                    @if (!string.IsNullOrEmpty(item.ImagenUrl))
                    {
                        <img src="@item.ImagenUrl"
                             style="width:44px;height:44px;border-radius:8px;object-fit:cover" />
                    }
                    else
                    {
                        <div style="width:44px;height:44px;border-radius:8px;
                                    background:var(--csf2);display:flex;
                                    align-items:center;justify-content:center;font-size:1.3rem">
                            👗
                        </div>
                    }
                    <div>
                        <p style="font-weight:500;color:var(--ctx);margin:0;font-size:.9rem">
                            @item.Nombre
                        </p>
                        <p style="font-size:.75rem;color:var(--ctx2);margin:0">
                            × @item.Cantidad @(!string.IsNullOrEmpty(item.Talla) ? "· " + item.Talla : "")
                        </p>
                    </div>
                </div>
                <span style="font-weight:600;color:var(--ctx)">
                    S/ @item.Subtotal.ToString("0.00")
                </span>
            </div>
        }
        <div style="display:flex;justify-content:space-between;
                    padding-top:.75rem;font-size:1.05rem">
            <span style="font-weight:600;color:var(--ctx)">Total a pagar</span>
            <span style="font-family:'Playfair Display',serif;
                         font-size:1.4rem;font-weight:700;color:var(--cp)">
                S/ @ViewBag.Total?.ToString("0.00")
            </span>
        </div>
    </div>

    <!-- Formulario de pago -->
    <form asp-action="Confirmar" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="lyra-card">
            <p style="font-weight:600;color:var(--ctx);margin:0 0 1rem;font-size:.95rem">
                Método de pago
            </p>

            <!-- Efectivo -->
            <label class="pay-method" id="lbl-efectivo">
                <input class="pay-radio" type="radio" name="metodoPago"
                       value="Efectivo al recibir" id="r-efectivo" />
                <span class="pay-icon">💵</span>
                <div>
                    <p class="pay-label">Efectivo al recibir</p>
                    <p class="pay-sub">Paga en la tienda al recoger tu prenda</p>
                </div>
                <span style="margin-left:auto;font-size:1.2rem;color:var(--cp)"
                      id="check-efectivo">○</span>
            </label>

            <!-- Tarjeta simulada -->
            <label class="pay-method" id="lbl-tarjeta">
                <input class="pay-radio" type="radio" name="metodoPago"
                       value="Tarjeta de crédito/débito" id="r-tarjeta" />
                <span class="pay-icon">💳</span>
                <div>
                    <p class="pay-label">Tarjeta de crédito / débito</p>
                    <p class="pay-sub">Pago seguro con tarjeta (simulado)</p>
                </div>
                <span style="margin-left:auto;font-size:1.2rem;color:var(--cp)"
                      id="check-tarjeta">○</span>
            </label>

            <!-- Datos de tarjeta simulados -->
            <div id="card-fields" style="display:none;margin-top:.5rem">
                <div class="card-sim">
                    <p style="font-size:.65rem;letter-spacing:.12em;
                               text-transform:uppercase;opacity:.6;margin:0 0 1.5rem">
                        PRECISA · Pago Seguro Simulado
                    </p>
                    <p style="font-size:1.3rem;letter-spacing:.18em;
                               margin:0 0 1.25rem;font-weight:300">
                        •••• •••• •••• 4242
                    </p>
                    <div style="display:flex;justify-content:space-between">
                        <div>
                            <p style="font-size:.6rem;opacity:.5;margin:0">Titular</p>
                            <p style="font-size:.85rem;margin:0">Tu Nombre</p>
                        </div>
                        <div>
                            <p style="font-size:.6rem;opacity:.5;margin:0">Vence</p>
                            <p style="font-size:.85rem;margin:0">12/28</p>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="lyra-label">Número de tarjeta</label>
                        <input class="lyra-input" type="text"
                               placeholder="•••• •••• •••• ••••"
                               maxlength="19" id="cardNum" />
                    </div>
                    <div class="col-md-3">
                        <label class="lyra-label">Vencimiento</label>
                        <input class="lyra-input" type="text"
                               placeholder="MM/AA" maxlength="5" />
                    </div>
                    <div class="col-md-3">
                        <label class="lyra-label">CVV</label>
                        <input class="lyra-input" type="text"
                               placeholder="•••" maxlength="3" />
                    </div>
                    <div class="col-12">
                        <label class="lyra-label">Nombre en la tarjeta</label>
                        <input class="lyra-input" type="text" placeholder="Como aparece en tu tarjeta" />
                    </div>
                </div>
                <div style="background:var(--csf2);border-radius:10px;
                            padding:.7rem 1rem;margin-top:.75rem;
                            font-size:.78rem;color:var(--ctx2)">
                    🔒 Simulación de pago — No se realizará ningún cargo real
                </div>
            </div>

            <!-- Transferencia -->
            <label class="pay-method" id="lbl-transferencia">
                <input class="pay-radio" type="radio" name="metodoPago"
                       value="Transferencia bancaria" id="r-transferencia" />
                <span class="pay-icon">🏦</span>
                <div>
                    <p class="pay-label">Transferencia bancaria</p>
                    <p class="pay-sub">La tienda te enviará los datos por WhatsApp</p>
                </div>
                <span style="margin-left:auto;font-size:1.2rem;color:var(--cp)"
                      id="check-transferencia">○</span>
            </label>
        </div>

        <!-- Notas -->
        <div class="lyra-card">
            <label class="lyra-label">Notas adicionales (opcional)</label>
            <textarea class="lyra-input" name="notas" rows="2"
                      placeholder="Indicaciones de entrega, talla exacta, etc."></textarea>
        </div>

        <button type="submit" class="btn-lyra w-100"
                id="confirmBtn"
                style="padding:.95rem;font-size:1rem;opacity:.5"
                disabled>
            Confirmar pedido →
        </button>

        <p style="text-align:center;font-size:.78rem;color:var(--ctx2);margin-top:.75rem">
            🔒 Al confirmar aceptas los términos de PRECISA.
            Recibirás los detalles de la tienda para coordinar la entrega.
        </p>
    </form>
</div>

<script>
const methods = ['efectivo','tarjeta','transferencia'];

methods.forEach(function(m) {
    const radio = document.getElementById('r-' + m);
    const lbl   = document.getElementById('lbl-' + m);
    const check = document.getElementById('check-' + m);

    radio.addEventListener('change', function() {
        methods.forEach(function(x) {
            document.getElementById('lbl-' + x).classList.remove('selected');
            document.getElementById('check-' + x).textContent = '○';
        });
        lbl.classList.add('selected');
        check.textContent = '✓';

        document.getElementById('card-fields').style.display =
            m === 'tarjeta' ? 'block' : 'none';

        const btn = document.getElementById('confirmBtn');
        btn.disabled = false;
        btn.style.opacity = '1';
    });

    lbl.addEventListener('click', function() {
        radio.checked = true;
        radio.dispatchEvent(new Event('change'));
    });
});

// Formatear número de tarjeta
const cardNum = document.getElementById('cardNum');
if (cardNum) {
    cardNum.addEventListener('input', function() {
        this.value = this.value.replace(/\D/g,'')
            .replace(/(.{4})/g,'$1 ').trim();
    });
}
</script>