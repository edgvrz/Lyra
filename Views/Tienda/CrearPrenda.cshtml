@using Lyra.Enums
@using Lyra.Services
@{ ViewData["Title"] = "Nueva Prenda"; }

@{
    var tiposCuerpo = new[]
    {
        (TipoCuerpoConst.RelojDeArena,     "⧗", "Cintura muy marcada, hombros ≈ cadera"),
        (TipoCuerpoConst.Triangulo,         "▽", "Cadera más ancha que hombros"),
        (TipoCuerpoConst.TrianguloInvert,   "△", "Hombros más anchos que cadera"),
        (TipoCuerpoConst.Rectangulo,        "▭", "Hombros, cintura y cadera similares"),
        (TipoCuerpoConst.Ovalado,           "◯", "Zona media prominente"),
    };

    var tonosPiel = new[]
    {
        (TonoPielEnum.Claro,      "Claro",       "#f5e6d5"),
        (TonoPielEnum.MedioClaro, "Medio Claro", "#e8c49a"),
        (TonoPielEnum.Medio,      "Medio",        "#c8844a"),
        (TonoPielEnum.Oliva,      "Oliva",        "#a0693a"),
        (TonoPielEnum.Moreno,     "Moreno",       "#7a4828"),
        (TonoPielEnum.Oscuro,     "Oscuro",       "#3d1f10"),
    };
}

<style>
.tipo-card {
    border: 2px solid var(--cbr);
    border-radius: 14px;
    padding: .9rem .75rem;
    text-align: center;
    cursor: pointer;
    transition: all .2s;
    background: var(--csf);
    user-select: none;
}
.tipo-card:hover { border-color: var(--cp); background: var(--csf2); }
.tipo-card.sel   { border-color: var(--cp); background: var(--grads); }
.tipo-icon { font-size: 2rem; line-height: 1; margin-bottom: .4rem; }
.tipo-name { font-weight: 600; font-size: .82rem; color: var(--ctx); }
.tipo-desc { font-size: .7rem; color: var(--ctx2); margin-top: .2rem; line-height: 1.3; }

.tono-card {
    border: 2px solid var(--cbr);
    border-radius: 50px;
    padding: .45rem .8rem;
    display: flex; align-items: center; gap: .5rem;
    cursor: pointer; transition: all .2s;
    background: var(--csf); user-select: none;
    font-size: .82rem; font-weight: 500; color: var(--ctx);
}
.tono-card:hover { border-color: var(--cp); }
.tono-card.sel   { border-color: var(--cp); background: var(--grads); color: var(--cp3); }
.tono-dot { width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
            border: 2px solid rgba(0,0,0,.1); }

.guide-banner {
    background: var(--grads);
    border: 1.5px solid var(--cbr);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex; align-items: center; gap: .75rem;
}
.step-num {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--grad);
    color: #fff; font-weight: 700; font-size: .85rem;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
</style>

<div class="lyra-wrap-sm">
    <div class="page-header">
        <div>
            <h1 class="lyra-title" style="font-size:1.9rem">Nueva prenda</h1>
            <p style="color:var(--ctx2);margin:.3rem 0 0;font-size:.9rem">
                Completa los datos para publicar
            </p>
        </div>
        <a asp-action="MisPrendas" class="btn-lyra-ghost btn-lyra-sm">← Mis prendas</a>
    </div>

    <form asp-action="CrearPrenda" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <!-- ── Información básica ── -->
        <div class="lyra-card">
            <p style="font-weight:600;color:var(--ctx);margin:0 0 1rem;font-size:.95rem">
                Información básica
            </p>
            <div class="mb-3">
                <label class="lyra-label">Nombre de la prenda *</label>
                <input class="lyra-input" type="text" name="nombre"
                       placeholder="Ej. Vestido floral manga larga" required />
            </div>
            <div class="mb-3">
                <label class="lyra-label">Descripción</label>
                <textarea class="lyra-input" name="descripcion" rows="2"
                          placeholder="Material, ocasión, detalles relevantes..."></textarea>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="lyra-label">Categoría *</label>
                    <select class="lyra-select" name="categoria" required>
                        <option value="">— Seleccionar —</option>
                        @foreach (var cat in Enum.GetValues<CategoriaRopa>())
                        { <option value="@cat">@cat</option> }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="lyra-label">Talla *</label>
                    <select class="lyra-select" name="talla" required>
                        @foreach (var t in Enum.GetValues<TallaPrenda>())
                        { <option value="@t">@t</option> }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="lyra-label">Color *</label>
                    <input class="lyra-input" type="text" name="color"
                           placeholder="Ej. Azul marino" required />
                </div>
                <div class="col-md-4">
                    <label class="lyra-label">Precio (S/) *</label>
                    <div class="medida-box">
                        <input class="lyra-input" type="number" step="0.01" name="precio"
                               placeholder="0.00" min="0" required style="padding-left:2.2rem" />
                        <span class="medida-unit" style="left:12px;right:auto">S/</span>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="lyra-label">Stock (unidades) *</label>
                    <input class="lyra-input" type="number" name="stock"
                           placeholder="0" min="0" value="1" required />
                </div>
            </div>
            <div class="mt-3">
                <label class="lyra-label">Imagen de la prenda</label>
                <input class="lyra-input" type="file" name="imagenFile"
                       accept="image/jpeg,image/png,image/webp"
                       style="padding:.5rem 1rem" />
                <p style="font-size:.74rem;color:var(--ctx2);margin-top:.3rem">
                    JPG, PNG o WEBP · Máx. 5 MB
                </p>
            </div>
        </div>

        <!-- ── GUÍA: Tipo de cuerpo ── -->
        <div class="guide-banner">
            <div class="step-num">1</div>
            <div>
                <p style="font-weight:600;margin:0;font-size:.9rem;color:var(--ctx)">
                    ¿Para qué tipo de cuerpo es esta prenda?
                </p>
                <p style="font-size:.78rem;color:var(--ctx2);margin:0">
                    Selecciona uno o más. La forma geométrica representa la silueta.
                </p>
            </div>
        </div>

        <div class="lyra-card">
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:.75rem"
                 id="tipoCuerpoGrid">
                @foreach (var (valor, icono, desc) in tiposCuerpo)
                {
                    var cid = "tc_" + valor.Replace(" ", "_");
                    <div>
                        <input type="checkbox" name="tiposCuerpo"
                               id="@cid" value="@valor"
                               style="display:none" class="tipo-input" />
                        <label for="@cid" class="tipo-card d-block">
                            <div class="tipo-icon">@icono</div>
                            <div class="tipo-name">@valor</div>
                            <div class="tipo-desc">@desc</div>
                        </label>
                    </div>
                }
            </div>
            <p style="font-size:.74rem;color:var(--ctx2);margin-top:.75rem">
                💡 <strong>Consejo:</strong> Si la prenda tiene cintura ajustada → Reloj de Arena.
                Si es amplia abajo → Triángulo Invertido. Si es recta → Rectángulo.
            </p>
        </div>

        <!-- ── GUÍA: Tono de piel ── -->
        <div class="guide-banner">
            <div class="step-num">2</div>
            <div>
                <p style="font-weight:600;margin:0;font-size:.9rem;color:var(--ctx)">
                    ¿A qué tonos de piel favorece el color de esta prenda?
                </p>
                <p style="font-size:.78rem;color:var(--ctx2);margin:0">
                    Piensa en los colores de la prenda y selecciona con cuáles
                    tonos de piel contrastan mejor.
                </p>
            </div>
        </div>

        <div class="lyra-card">
            <!-- Guía de referencia de colores -->
            <div style="background:var(--csf2);border-radius:10px;padding:.85rem 1rem;
                        margin-bottom:1rem;font-size:.78rem;color:var(--ctx2);line-height:1.7">
                🎨 <strong>Referencia rápida:</strong><br>
                • Colores <strong>fríos</strong> (azul, verde, morado, gris) → favorecen tonos <strong>Claro y Medio Claro</strong><br>
                • Colores <strong>tierra</strong> (camel, mostaza, terracota) → favorecen tonos <strong>Medio, Oliva y Moreno</strong><br>
                • Colores <strong>brillantes</strong> (blanco, rojo vivo, fucsia) → favorecen tonos <strong>Moreno y Oscuro</strong><br>
                • Colores <strong>neutros</strong> (negro, blanco, beige) → funcionan para <strong>todos</strong>
            </div>

            <div style="display:flex;flex-wrap:wrap;gap:.55rem" id="tonoPielGrid">
                @foreach (var (valor, nombre, hex) in tonosPiel)
                {
                    var tid = "tp_" + valor;
                    <div>
                        <input type="checkbox" name="tonosPiel"
                               id="@tid" value="@valor"
                               style="display:none" class="tono-input" />
                        <label for="@tid" class="tono-card">
                            <span class="tono-dot" style="background:@hex"></span>
                            @nombre
                        </label>
                    </div>
                }
            </div>
        </div>

        <button type="submit" class="btn-lyra w-100" style="padding:.95rem">
            Publicar prenda ✓
        </button>
    </form>
</div>

<script>
// Tipo cuerpo: toggle visual
document.querySelectorAll('.tipo-input').forEach(function(inp) {
    inp.addEventListener('change', function() {
        var label = document.querySelector('label[for="' + inp.id + '"]');
        label.classList.toggle('sel', inp.checked);
    });
});
// Tono piel: toggle visual
document.querySelectorAll('.tono-input').forEach(function(inp) {
    inp.addEventListener('change', function() {
        var label = document.querySelector('label[for="' + inp.id + '"]');
        label.classList.toggle('sel', inp.checked);
    });
});
</script>