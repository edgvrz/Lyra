@model Lyra.Models.Tienda
@{ ViewData["Title"] = "Solicitud enviada"; Layout = "_Layout"; }

<div style="font-family:'DM Sans',sans-serif;max-width:560px;margin:5rem auto;padding:0 1rem;text-align:center">

    <div style="font-size:3.5rem;margin-bottom:1.5rem">⏳</div>

    <h1 style="font-family:'Playfair Display',serif;font-size:1.8rem;color:#1a1a1a;margin-bottom:.75rem">
        Solicitud enviada
    </h1>

    <p style="color:#888;font-size:.95rem;line-height:1.7;margin-bottom:2rem">
        Tu tienda <strong style="color:#1a1a1a">@Model.Nombre</strong> está siendo revisada
        por nuestro equipo. Te notificaremos cuando sea aprobada y podrás
        empezar a publicar prendas.
    </p>

    <div style="background:#faf8f5;border:1px solid #ede9e3;border-radius:14px;padding:1.5rem;margin-bottom:2rem;text-align:left">
        <p style="font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;color:#aaa;margin-bottom:1rem">
            Datos de tu solicitud
        </p>
        <div style="display:flex;flex-direction:column;gap:.5rem;font-size:.9rem;color:#555">
            <div style="display:flex;justify-content:space-between">
                <span>Nombre</span>
                <span style="color:#1a1a1a;font-weight:500">@Model.Nombre</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Ciudad))
            {
                <div style="display:flex;justify-content:space-between">
                    <span>Ciudad</span>
                    <span style="color:#1a1a1a">@Model.Ciudad</span>
                </div>
            }
            <div style="display:flex;justify-content:space-between">
                <span>Estado</span>
                <span class="pill pill-yellow">Pendiente de revisión</span>
            </div>
            <div style="display:flex;justify-content:space-between">
                <span>Fecha</span>
                <span style="color:#1a1a1a">@Model.FechaRegistro.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    </div>

    <p style="font-size:.82rem;color:#bbb">
        ¿Preguntas? Escríbenos a
        <a href="mailto:admin@lyra.com" style="color:#888">admin@lyra.com</a>
    </p>

<form asp-area="Identity" asp-page="/Account/Logout"
      asp-route-returnUrl="/" method="post" style="margin-top:1.5rem">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-lyra-ghost" style="width:100%;justify-content:center">
            Cerrar sesión
        </button>
    </form>
</div>