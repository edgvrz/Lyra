@{ ViewData["Title"] = "PRECISA — Precisamente Bella"; }

<div style="font-family:'DM Sans',sans-serif">

    <!-- Hero -->
    <section style="background:var(--herograd);color:#fff;
                    padding:5.5rem 1rem;text-align:center;position:relative;overflow:hidden">
        <div style="position:absolute;inset:0;
                    background:url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2240%22 fill=%22none%22 stroke=%22white%22 stroke-opacity=%220.04%22 stroke-width=%222%22/></svg>') center/120px repeat">
        </div>
        <div style="position:relative;z-index:1;max-width:640px;margin:0 auto">
            <img src="~/img/precisa-logo.png" alt="PRECISA"
                 style="height:90px;margin-bottom:1.5rem;
                        filter:drop-shadow(0 4px 20px rgba(0,0,0,.3))"
                 onerror="this.style.display='none'" />
            <p style="font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;
                      color:rgba(255,255,255,.6);margin-bottom:.75rem">
                Precisamente Bella
            </p>
            <h1 style="font-family:'Playfair Display',serif;
                       font-size:clamp(2.4rem,5.5vw,3.8rem);
                       font-weight:700;margin:0 0 1.25rem;line-height:1.15">
                Ropa hecha para<br>
                <span style="font-style:italic;opacity:.85">tu cuerpo real</span>
            </h1>
            <p style="color:rgba(255,255,255,.75);font-size:1rem;
                      max-width:480px;margin:0 auto 2.5rem;line-height:1.8">
                PRECISA analiza tu tipo de cuerpo y tono de piel para
                recomendarte prendas de tiendas locales que realmente te favorecen.
            </p>
            <div style="display:flex;justify-content:center;gap:1rem;flex-wrap:wrap">
                <a asp-area="Identity" asp-page="/Account/Register"
                   style="background:#fff;color:var(--cp);font-weight:700;
                          border-radius:12px;padding:.9rem 2.2rem;
                          font-size:.95rem;text-decoration:none;
                          box-shadow:0 6px 24px rgba(0,0,0,.2);transition:all .2s">
                    Empieza gratis →
                </a>
                <a asp-area="Identity" asp-page="/Account/Login"
                   style="background:transparent;color:#fff;
                          border:1.5px solid rgba(255,255,255,.4);
                          border-radius:12px;padding:.9rem 2rem;
                          font-size:.95rem;text-decoration:none;transition:all .2s">
                    Ya tengo cuenta
                </a>
            </div>
        </div>
    </section>

    <!-- Cómo funciona -->
    <section style="max-width:1000px;margin:5rem auto;padding:0 1rem">
        <p style="text-align:center;font-size:.75rem;letter-spacing:.15em;
                  text-transform:uppercase;color:var(--ctx2);margin-bottom:.5rem">
            ¿Cómo funciona?
        </p>
        <h2 style="font-family:'Playfair Display',serif;font-size:2rem;
                   text-align:center;color:var(--ctx);margin-bottom:3rem">
            3 pasos para encontrar tu estilo
        </h2>

        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1.75rem">
            @foreach (var (num, ico, titulo, desc) in new[] {
                ("01", "📏", "Ingresa tus medidas",
                 "Registra hombros, busto, cintura y cadera. Nuestro sistema detecta tu tipo de cuerpo al instante."),
                ("02", "✨", "Recibe recomendaciones",
                 "PRECISA cruza tu perfil corporal con prendas de tiendas locales y te muestra solo lo que te favorece."),
                ("03", "🛍", "Reserva y luce",
                 "Reserva la prenda en línea o visita la tienda. Sin incertidumbre, solo seguridad y estilo.")
            })
            {
                <div class="lyra-card" style="position:relative;overflow:hidden">
                    <div style="position:absolute;top:-10px;right:-10px;
                                font-family:'Playfair Display',serif;
                                font-size:5rem;font-weight:700;
                                color:var(--cbr);line-height:1;pointer-events:none">
                        @num
                    </div>
                    <div style="font-size:2rem;margin-bottom:.75rem">@ico</div>
                    <p style="font-family:'Playfair Display',serif;font-size:1.1rem;
                              color:var(--ctx);margin:0 0 .5rem;font-weight:600">@titulo</p>
                    <p style="font-size:.88rem;color:var(--ctx2);margin:0;line-height:1.7">
                        @desc
                    </p>
                </div>
            }
        </div>
    </section>

    <!-- CTA para tiendas -->
    <section style="background:var(--csf);border-top:1.5px solid var(--cbr);
                    border-bottom:1.5px solid var(--cbr);padding:4rem 1rem;text-align:center">
        <p style="font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;
                  color:var(--ctx2);margin-bottom:.5rem">Para negocios</p>
        <h2 style="font-family:'Playfair Display',serif;font-size:1.9rem;
                   color:var(--ctx);margin-bottom:.75rem">
            ¿Tienes una tienda de ropa?
        </h2>
        <p style="color:var(--ctx2);font-size:.92rem;margin-bottom:2rem;max-width:440px;
                  margin-left:auto;margin-right:auto;line-height:1.7">
            Regístrate con un correo <strong>@("tienda.com")</strong> y conecta con
            clientas que buscan exactamente lo que vendes.
        </p>
        <a asp-area="Identity" asp-page="/Account/Register"
           class="btn-lyra" style="padding:.9rem 2.4rem">
            Registrar mi tienda →
        </a>
    </section>
</div>