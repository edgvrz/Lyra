<!DOCTYPE html>
<html lang="es" data-theme="plateado">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PRECISA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Lyra.styles.css" asp-append-version="true" />
    <!-- Aplicar tema ANTES del render para evitar flash -->
    <script>
        (function(){
            var t=localStorage.getItem('precisa-theme')||'plateado';
            document.documentElement.setAttribute('data-theme',t);
        })();
    </script>
</head>
<body>

<nav class="precisa-nav">
    <div class="precisa-nav-inner">

        <!-- Brand -->
        <a asp-controller="Home" asp-action="Index" class="precisa-brand">
            <img src="~/img/precisa-logo.png" alt="PRECISA"
                 class="precisa-logo-img"
                 onerror="this.style.display='none'" />
            <div class="precisa-brand-text">
                <span class="precisa-brand-name">PRECISA</span>
                <span class="precisa-brand-sub">Precisamente Bella</span>
            </div>
        </a>

        <!-- Nav links por rol -->
        <div class="precisa-nav-links">
            @if (User.Identity?.IsAuthenticated == true)
            {
                if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard"  class="precisa-nav-link">Panel</a>
                    <a asp-controller="Admin" asp-action="Usuarios"   class="precisa-nav-link">Usuarias</a>
                    <a asp-controller="Admin" asp-action="Tiendas"    class="precisa-nav-link">Tiendas</a>
                    <a asp-controller="Admin" asp-action="Prendas"    class="precisa-nav-link">Catálogo</a>
                }
                else if (User.IsInRole("Tienda"))
                {
                    <a asp-controller="Tienda" asp-action="Dashboard"   class="precisa-nav-link">Mi tienda</a>
                    <a asp-controller="Tienda" asp-action="MisPrendas"  class="precisa-nav-link">Prendas</a>
                    <a asp-controller="Tienda" asp-action="MisReservas" class="precisa-nav-link">📋 Reservas</a>
                    <a asp-controller="Tienda" asp-action="CrearPrenda" class="precisa-nav-link">+ Publicar</a>
                }
                else if (User.IsInRole("Cliente"))
                {
                    <a asp-controller="Cliente" asp-action="Dashboard"       class="precisa-nav-link">Inicio</a>
                    <a asp-controller="Cliente" asp-action="Recomendaciones" class="precisa-nav-link">✨ Para ti</a>
                    <a asp-controller="Cliente" asp-action="Favoritos"       class="precisa-nav-link">♥ Guardadas</a>
                    <a asp-controller="Cliente" asp-action="MisReservas"     class="precisa-nav-link">📋 Reservas</a>
                    <a asp-controller="Carrito" asp-action="MisPedidos"      class="precisa-nav-link">📦 Pedidos</a>
                }
            }
        </div>

        <!-- Derecha -->
        <div class="precisa-nav-right">
            @if (User.IsInRole("Cliente"))
{
    <a asp-controller="Carrito" asp-action="Index"
       style="position:relative;text-decoration:none;
              display:flex;align-items:center;justify-content:center;
              width:38px;height:38px;border-radius:50%;
              border:1.5px solid var(--cbr);background:var(--csf);
              color:var(--ctx);transition:all .2s;
              box-shadow:0 2px 8px var(--csh);"
       title="Mi carrito">
        🛒
        @{
            var carritoCount = 0;
            try {
                var carritoSvc = Context.RequestServices
                    .GetService<Lyra.Services.CarritoService>();
                if (carritoSvc != null)
                    carritoCount = carritoSvc.ContarItems();
            } catch { }
        }
        @if (carritoCount > 0)
        {
            <span style="position:absolute;top:-4px;right:-4px;
                          width:18px;height:18px;border-radius:50%;
                          background:var(--grad);color:#fff;
                          font-size:.62rem;font-weight:700;
                          display:flex;align-items:center;justify-content:center;
                          border:2px solid var(--csf)">
                @carritoCount
            </span>
        }
    </a>
}
            <!-- Theme picker -->
            <div class="theme-picker" id="themePicker">
                <button class="theme-toggle-btn" id="themeToggleBtn" title="Cambiar tema">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="5"/>
                        <line x1="12" y1="1"  x2="12" y2="3"/>
                        <line x1="12" y1="21" x2="12" y2="23"/>
                        <line x1="4.22" y1="4.22"   x2="5.64"  y2="5.64"/>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                        <line x1="1" y1="12" x2="3" y2="12"/>
                        <line x1="21" y1="12" x2="23" y2="12"/>
                        <line x1="4.22"  y1="19.78" x2="5.64"  y2="18.36"/>
                        <line x1="18.36" y1="5.64"  x2="19.78" y2="4.22"/>
                    </svg>
                </button>
                <div class="theme-dropdown" id="themeDropdown">
                    <p class="theme-dd-title">Elige tu estilo</p>
                    <div class="theme-options">
                        <button class="theme-option" data-theme="plateado">
                            <span class="theme-dot"
                                  style="background:linear-gradient(135deg,#4a6fa5,#7096c8)"></span>
                            Plateado
                        </button>
                        <button class="theme-option" data-theme="rojo">
                            <span class="theme-dot"
                                  style="background:linear-gradient(135deg,#8a1010,#d94040)"></span>
                            Rojo
                        </button>
                        <button class="theme-option" data-theme="cereza">
                            <span class="theme-dot"
                                  style="background:linear-gradient(135deg,#620f33,#b83060)"></span>
                            Cereza
                        </button>
                        <button class="theme-option" data-theme="rosa">
                            <span class="theme-dot"
                                  style="background:linear-gradient(135deg,#9a1450,#e04d88)"></span>
                            Rosa
                        </button>
                    </div>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="/" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="precisa-logout-btn">Salir</button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login"
                   class="precisa-nav-link">Entrar</a>
                <a asp-area="Identity" asp-page="/Account/Register"
                   class="precisa-register-btn">Registrarse</a>
            }
        </div>
    </div>
</nav>

@if (TempData["Error"] != null)
{
    <div class="precisa-alert">
        <div class="lyra-wrap" style="padding-top:0;padding-bottom:0">
            ⚠ @TempData["Error"]
        </div>
    </div>
}

<main>@RenderBody()</main>

<footer class="precisa-footer">
    <div class="precisa-footer-inner">
        <div class="precisa-footer-brand">
            <img src="~/img/precisa-logo.png" alt="PRECISA"
                 style="height:24px;opacity:.7"
                 onerror="this.style.display='none'" />
            PRECISA
        </div>
        <p style="font-size:.78rem;color:var(--ctx2)">
            © @DateTime.Now.Year PRECISA — Moda inteligente para ti
        </p>
        <p style="font-size:.72rem;color:var(--ctx2);opacity:.5;
                  font-family:'Playfair Display',serif;font-style:italic">
            Precisamente Bella
        </p>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script>
(function(){
    var saved = localStorage.getItem('precisa-theme') || 'plateado';

    function applyTheme(t){
        document.documentElement.setAttribute('data-theme', t);
        localStorage.setItem('precisa-theme', t);
        document.querySelectorAll('.theme-option').forEach(function(b){
            b.classList.toggle('active', b.dataset.theme === t);
        });
    }
    applyTheme(saved);

    var toggleBtn  = document.getElementById('themeToggleBtn');
    var dropdown   = document.getElementById('themeDropdown');

    toggleBtn.addEventListener('click', function(e){
        e.stopPropagation();
        dropdown.classList.toggle('open');
    });
    document.querySelectorAll('.theme-option').forEach(function(btn){
        btn.addEventListener('click', function(){
            applyTheme(btn.dataset.theme);
            dropdown.classList.remove('open');
        });
    });
    document.addEventListener('click', function(e){
        if(!e.target.closest('#themePicker')) dropdown.classList.remove('open');
    });
})();
</script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>